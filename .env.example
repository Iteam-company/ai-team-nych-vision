# Public origin of the site, without a trailing slash.
# Used for canonical URLs, hreflang, sitemap.xml, robots.txt and Open Graph.
NEXT_PUBLIC_SITE_URL=

# Telegram contact for the hero CTA: a username (without @) or a phone number
TELEGRAM_USER=

# Contact form → Telegram. Create a bot with @BotFather to get the token, add
# the bot to the chat that should receive bookings, then put that chat's id here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
